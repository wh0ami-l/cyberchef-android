# Copy to android/keystore.properties and fill in, or run scripts/make-keystore.sh.
#
# This file is GITIGNORED. Never commit real credentials: the keystore plus its
# password let anyone sign an APK that Android will install as an update over
# yours.
#
# In CI, leave this file absent and set the environment variables instead:
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

storeFile=keystore/cyberchef-release.jks
storePassword=change-me
keyAlias=cyberchef
keyPassword=change-me
